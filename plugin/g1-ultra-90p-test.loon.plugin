#!name = G1 Ultra 测试 · 30TB 3M 90p
#!desc = 只测一条：把 one.google.com/ai 页面响应里的 g1.ios.30tb.ai.pro.m 换成 g1.ai.ultra.3months_ip_90p.acq（Ultra 30TB 3 个月 1 折档）。测试用，确认有效后再并入正式插件。
#!author = duang (Loon port)
#!homepage = https://ios.duang.org/g1-ultra.sgmodule
#!system = iOS,iPadOS
#!date = 2026-11-26
#!tag = Google,Rewrite
#!type = normal

[Rewrite]
# 你给的那行改了两处：去掉 /g（Loon 的 regex flag 只有 i / m / s），替换值去掉 http:// 前缀（那是自动链接化加的，SKU 本身不带协议）。
response if ${url} ~= /^https:\/\/one\.google\.com\/ai(?:\?.*)?$/ then response.body.replace(/g1\.ios\.30tb\.ai\.pro\.m/, "g1.ai.ultra.3months_ip_90p.acq")

# 旧版 Loon 备用（Build 729+）：删掉上面一行，启用下面这行。
# ^https:\/\/one\.google\.com\/ai\?.*$ response-body-replace-regex g1\.ios\.30tb\.ai\.pro\.m g1.ai.ultra.3months_ip_90p.acq

[Rule]
# Google app 走 HTTP/3 时 MITM 拦不到，必须屏蔽 UDP 443 才会回退到 TCP。
# Surge 的 REJECT-NO-DROP 在 Loon 里对应 REJECT-DROP（静默丢弃，不回包）。
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-DROP

[Mitm]
# 只留测试需要的域名，避免动到 Play / 支付域名。
hostname = one.google.com
